# Database connection string. Defaults to a local SQLite file if unset.
# Example for Postgres: postgresql://user:password@host:5432/dbname
DATABASE_URL=sqlite:///liftlogic.db

# Signing key for session cookies. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Set to "production" to require HTTPS-only session cookies.
FLASK_ENV=development

# Port the app listens on when run directly via `python app.py`.
PORT=5000
